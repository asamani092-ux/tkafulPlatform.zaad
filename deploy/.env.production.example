# قالب إنتاج — نطاق جمعية الزاد (كولفاي / VPS)
# انسخ القيم إلى Environment في كولفاي. لا تُودِع كلمات المرور الحقيقية في git.

SECRET_KEY=generate-a-long-random-secret-here
DEBUG=False
ALLOWED_HOSTS=tkaful.alzaad.org.sa,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://tkaful.alzaad.org.sa
CSRF_TRUSTED_ORIGINS=https://tkaful.alzaad.org.sa
# Coolify ينهي TLS أمام الحاوية — لا تُجبر إعادة توجيه SSL داخل الحاوية
SECURE_SSL_REDIRECT=False

# من مورد PostgreSQL في كولفاي
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# بريد أوتلوك (Microsoft 365)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=tkaful@alzaad.org.sa
EMAIL_HOST_PASSWORD=PUT_OUTLOOK_APP_PASSWORD_HERE
DEFAULT_FROM_EMAIL=tkaful@alzaad.org.sa
SERVER_EMAIL=tkaful@alzaad.org.sa
# طارئ فقط أثناء ضبط SMTP — احذفه أو False بعد نجاح إرسال الرموز
LOGIN_OTP_DISABLED=True

# متجر التبرّع الخارجي (إن وُجد)
EXTERNAL_STORE_URL=

# مدير النظام — يُنشأ/يُحدَّث عبر: python manage.py create_admin
# الدخول من الواجهة بالبريد + كلمة المرور (بدون OTP)
ADMIN_USERNAME=td
ADMIN_EMAIL=td@alzaad.org.sa
ADMIN_PASSWORD=12341234

# Google Maps — ضعه أيضاً كـ Build Argument في كولفاي (Vite يحتاجه وقت البناء)
# VITE_GOOGLE_MAPS_API_KEY=your-browser-key

# لا تفعّل في الإنتاج:
# UAT_ENABLED=False
# VITE_ENABLE_UAT=
