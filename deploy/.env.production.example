# Production environment template — copy to backend/.env on VPS

SECRET_KEY=generate-a-long-random-secret-here
DEBUG=False
ALLOWED_HOSTS=app.client.org,localhost,127.0.0.1

DATABASE_URL=postgres://takaful:strong-password@127.0.0.1:5432/takaful

CORS_ALLOWED_ORIGINS=https://app.client.org
CSRF_TRUSTED_ORIGINS=https://app.client.org

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@client.org
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@client.org

EXTERNAL_STORE_URL=https://store.client.org/donate

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@client.org
ADMIN_PASSWORD=change-me-on-first-run
