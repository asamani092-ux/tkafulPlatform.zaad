# نموذج متغيّرات البيئة لمنصة تكافل وأثر (backend)
# انسخه إلى backend/.env واضبط القيم. لا تُودِع .env في git.

# الأمان — إلزامي في الإنتاج
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# قاعدة البيانات (افتراضياً SQLite محلياً؛ في الإنتاج استخدم PostgreSQL)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# البريد (محلياً: console — إنتاج أوتلوك: smtp.office365.com)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tkaful@alzaad.org.sa
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=tkaful@alzaad.org.sa

# حساب المشرف الافتراضي (يُنشأ عبر create_admin) — غيّر كلمة المرور بعد أول دخول
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@takaful.com
ADMIN_PASSWORD=change-me

# متجر التبرّع الخارجي (كفالات السقيا — redirect فقط)
EXTERNAL_STORE_URL=
